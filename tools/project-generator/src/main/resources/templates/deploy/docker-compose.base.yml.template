services:
  db-migrator:
    build:
      context: ../
      dockerfile: Dockerfile
    command: [ "--migrate-only" ]
    depends_on:
      db:
        condition: service_healthy
    environment:
      INSTANCE_MODE: PUBLIC
      DB_MIGRATE_ON_STARTUP: "true"
    secrets:
      - DB_USER
      - DB_PASSWORD
      - REDIS_URL
      - JWT_SECRET
      - TOTP_ENCRYPTION_SECRET
      - ADMIN_ACCOUNTS_JSON
      - S3_ACCESS_KEY
      - S3_SECRET_KEY
    networks:
      - app-network

  app-public:
    build:
      context: ../
      dockerfile: Dockerfile
    ports:
      - "8080:8080"
    depends_on:
      db:
        condition: service_healthy
      db-migrator:
        condition: service_completed_successfully
      minio:
        condition: service_healthy
    environment:
      INSTANCE_MODE: PUBLIC
      DB_MIGRATE_ON_STARTUP: "false"
    secrets:
      - DB_USER
      - DB_PASSWORD
      - REDIS_URL
      - JWT_SECRET
      - TOTP_ENCRYPTION_SECRET
      - ADMIN_ACCOUNTS_JSON
      - S3_ACCESS_KEY
      - S3_SECRET_KEY
    networks:
      - app-network

  db:
    image: postgres:18.0
    environment:
      POSTGRES_USER_FILE: /run/secrets/DB_USER
      POSTGRES_PASSWORD_FILE: /run/secrets/DB_PASSWORD
      POSTGRES_DB: {{PROJECT_NAME}}_db
    secrets:
      - DB_USER
      - DB_PASSWORD
    volumes:
      - db_data:/var/lib/postgresql
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U $$(cat /run/secrets/DB_USER) -d {{PROJECT_NAME}}_db" ]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - app-network

  redis:
    image: redis:8.4.0-alpine
    secrets:
      - REDIS_URL
    networks:
      - app-network

  minio:
    image: minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      MINIO_ROOT_USER_FILE: /run/secrets/S3_ACCESS_KEY
      MINIO_ROOT_PASSWORD_FILE: /run/secrets/S3_SECRET_KEY
    secrets:
      - S3_ACCESS_KEY
      - S3_SECRET_KEY
    volumes:
      - minio_data:/data
    command: server /data --console-address ":9001"
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:9000/minio/health/live" ]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - app-network

secrets:
  DB_USER:
    file: ./secrets/DB_USER
  DB_PASSWORD:
    file: ./secrets/DB_PASSWORD
  REDIS_URL:
    file: ./secrets/REDIS_URL
  JWT_SECRET:
    file: ./secrets/JWT_SECRET
  TOTP_ENCRYPTION_SECRET:
    file: ./secrets/TOTP_ENCRYPTION_SECRET
  ADMIN_ACCOUNTS_JSON:
    file: ./secrets/ADMIN_ACCOUNTS_JSON
  S3_ACCESS_KEY:
    file: ./secrets/S3_ACCESS_KEY
  S3_SECRET_KEY:
    file: ./secrets/S3_SECRET_KEY

networks:
  app-network:
    driver: bridge

volumes:
  db_data:
  minio_data:
