# Build stage
FROM eclipse-temurin:{{TOOLCHAIN_JVM}}-jdk-alpine AS builder
WORKDIR /app
COPY . .
RUN ./gradlew jar --no-daemon

# Runtime stage
FROM eclipse-temurin:{{TOOLCHAIN_JVM}}-jre-alpine AS runner
WORKDIR /app
COPY --from=builder /app/build/libs/app.jar app.jar
COPY --from=builder /app/build/libs/lib /app/lib

EXPOSE 8080 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
