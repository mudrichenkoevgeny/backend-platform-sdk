# Auto-detect text files and enforce LF
* text=auto eol=lf

# Source code & docs
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf

# Configs (Ktor & Database)
*.conf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf

# Executables & scripts
*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jar binary
*.klib binary
*.keystore binary
*.jks binary