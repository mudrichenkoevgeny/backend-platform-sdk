root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = off
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120

ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
ij_kotlin_continuation_indent_size = 4
ij_kotlin_keep_line_breaks = true
ij_kotlin_assignment_wrap = normal
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, ^
ij_kotlin_method_call_chain_wrap = normal
ij_kotlin_wrap_first_method_in_call_chain = false
ij_kotlin_method_parameters_wrap = split_into_lines
ij_kotlin_method_parameters_new_line_after_left_paren = true
ij_kotlin_method_parameters_right_paren_on_new_line = true
ij_kotlin_call_parameters_wrap = normal
ij_kotlin_call_parameters_new_line_after_left_paren = false
ij_kotlin_call_parameters_right_paren_on_new_line = false

# https://ktlint.github.io/ktlint/latest/rules/code-styles/
ktlint_code_style = intellij_idea

# https://pinterest.github.io/ktlint/latest/rules/standard/#function-signature
ktlint_standard_function-signature = disabled

# https://pinterest.github.io/ktlint/latest/rules/standard/#class-signature
ktlint_standard_class-signature = disabled

# https://pinterest.github.io/ktlint/latest/rules/standard/#parameter-list-wrapping
ktlint_standard_parameter-list-wrapping = disabled

# https://pinterest.github.io/ktlint/latest/rules/standard/#no-line-break-before-assignment
ktlint_standard_no-line-break-before-assignment = enabled

# https://pinterest.github.io/ktlint/latest/rules/standard/#binary-expression-wrapping
ktlint_standard_binary-expression-wrapping = enabled

# https://pinterest.github.io/ktlint/latest/rules/standard/#multiline-expression-wrapping
ktlint_standard_multiline-expression-wrapping = disabled

# https://pinterest.github.io/ktlint/latest/rules/standard/#annotation-formatting
ktlint_standard_annotation = disabled

# https://pinterest.github.io/ktlint/latest/rules/standard/#trailing-comma-on-call-site
ktlint_standard_trailing-comma-on-call-site = disabled

# https://pinterest.github.io/ktlint/latest/rules/standard/#trailing-comma-on-declaration-site
ktlint_standard_trailing-comma-on-declaration-site = disabled

# https://pinterest.github.io/ktlint/latest/rules/standard/#import-ordering
ktlint_standard_import-ordering = disabled

[*.md]
trim_trailing_whitespace = false
ij_formatter_enabled = false

[*.{yml,yaml}]
indent_size = 2

[*.properties]
ij_formatter_enabled = false

[*.json]
indent_size = 2

# --- BACKEND OVERRIDES ---
# Add backend-specific editorconfig rules below

# --- LOCAL OVERRIDES ---
# Add project-specific editorconfig rules below
