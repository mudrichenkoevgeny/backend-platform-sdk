# Environment: dev, test, prod
ENVIRONMENT=dev
INSTANCE_MODE=FULL

APP_PORT=8080
ADMIN_APP_PORT=9091

LOG_PATH=./logs

# App name
APP_NAME=mudrichenkoevgeny-backend-platform-sdk-sample-dev

SERVER_URL="http://localhost:8080"

KTOR_SERVER_HOST=0.0.0.0
KTOR_SERVER_PORT=8080
KTOR_MANAGEMENT_PORT=9090

# Database
DB_PORT=5432
DB_NAME=mudrichenkoevgeny_backend_platform_sdk_sample_dev_db
DB_URL=jdbc:postgresql://db:5432/mudrichenkoevgeny_backend_platform_sdk_sample_dev_db?currentSchema=public
# DB_URL=jdbc:postgresql://localhost:5432/mudrichenkoevgeny_backend_platform_sdk_sample_dev_db # for local build
DB_WAIT_TIMEOUT=90

# App-specific values
AUTH_REALM=mudrichenkoevgeny-backend-platform-sdk-sample-dev-realm
DOMAIN=example.com
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000,http://localhost:5173,https://example.com

# Secrets
DB_USER_SECRET_FILE=DB_USER
DB_PASSWORD_SECRET_FILE=DB_PASSWORD
REDIS_URL_SECRET_FILE=REDIS_URL
REDIS_TIMEOUT_SECONDS=5
JWT_SECRET_FILE=JWT_SECRET
TOTP_ENCRYPTION_SECRET_FILE=TOTP_ENCRYPTION_SECRET
ADMIN_ACCOUNTS_JSON_SECRET_FILE=ADMIN_ACCOUNTS_JSON

# Swagger
SWAGGER_TITLE="Mudrichenko Evgeny Backend Platform SDK Sample API [DEV]"
SWAGGER_DESCRIPTION="Sample backend service. Use this instance for development and testing purposes."
SWAGGER_SERVER_DESCRIPTION="Local Development Server"

# Telemetry
TELEMETRY_SERVICE_NAME=mudrichenkoevgeny-backend-platform-sdk-sample-dev-otel
TELEMETRY_ENDPOINT=http://otel-collector:4317
METRIC_INTERVAL_SECONDS=10
PROMETHEUS_ENDPOINT=0.0.0.0:9464
TELEMETRY_LOG_LEVEL=debug

# Logs
OTEL_LOG_LEVEL=debug
JAEGER_ENDPOINT=jaeger:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

LOKI_SHARED_STORE=filesystem

# Rate limit
RATE_LIMIT=100
RATE_LIMIT_PERIOD_SECONDS=60

# Services
# UniOne
# UNIONE_API_KEY_FILE=UNIONE_API_KEY
# UNIONE_URL=https://api.unione.io/en/transactional/api/v1/
# UNIONE_FROM_EMAIL=noreply@mudr.life
# UNIONE_FROM_NAME="Mudr Life"
# UNIONE_TRACK_DOMAIN=mail.mudr.life
# UNIONE_API_SEND="email/send.json"
# Resend
RESEND_API_KEY_FILE=RESEND_API_KEY
RESEND_URL=https://api.resend.com
RESEND_FROM_EMAIL=noreply@mudr.life
RESEND_FROM_NAME="Mudr Life"

# Events
EVENTS_TYPE=KAFKA
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=mudrichenkoevgeny-backend-platform-sdk-sample-dev-core-group
KAFKA_CLIENT_ID=main-backend-service

# Storage
STORAGE_TYPE=S3 # LOCAL or S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET_NAME=files
S3_PUBLIC_URL=http://localhost:9000/files
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_PATH=uploads
S3_ACCESS_KEY_FILE=S3_ACCESS_KEY
S3_SECRET_KEY_FILE=S3_SECRET_KEY

PRIVACY_POLICY_URL=https://example.com/privacy-policy
TERMS_OF_SERVICE_URL=https://example.com/terms-of-service
CONTACT_SUPPORT_EMAIL=support@example.com

# Security
RECENT_AUTHENTICATION_VALIDITY_IN_SECONDS=600
RECENT_AUTHENTICATION_VALIDITY_IN_SECONDS_FOR_MANAGEMENT=1800
PASSWORD_POLICY_MIN_LENGTH=8
PASSWORD_POLICY_REQUIRE_LETTER=true
PASSWORD_POLICY_REQUIRE_UPPER_CASE=false
PASSWORD_POLICY_REQUIRE_LOWER_CASE=false
PASSWORD_POLICY_REQUIRE_DIGIT=false
PASSWORD_POLICY_REQUIRE_SPECIAL_CHAR=false

AVAILABLE_AUTH_PROVIDERS_PRIMARY=EMAIL,PHONE
AVAILABLE_AUTH_PROVIDERS_SECONDARY=GOOGLE
MAX_TOTAL_IDENTIFIERS=5
MAX_EMAIL_IDENTIFIERS=2
MAX_PHONE_IDENTIFIERS=2
MAX_IDENTIFIERS_PER_EXTERNAL_PROVIDER=2
MAX_ACTIVE_SESSIONS=5
ACCESS_TOKEN_EXPIRATION_SECONDS=3600
REFRESH_TOKEN_EXPIRATION_SECONDS=2592000
OTP_RETRY_AFTER_SECONDS=60
OTP_NUMBER_OF_SYMBOLS=6
OTP_EXPIRATION_SECONDS=300
MFA_TOKEN_EXPIRATION_SECONDS=300
ACCOUNT_DELETION_DELAY_SECONDS=2592000

GOOGLE_WEB_CLIENT_ID=982478008604-albtrhoegkqkpe2ev7rirg6c8h9hijfl.apps.googleusercontent.com