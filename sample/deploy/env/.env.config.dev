# =====================================================================
# 1. SYSTEM & INFRASTRUCTURE VARIABLES (Not configurable via admin panel)
# =====================================================================

# Environment & Server
ENVIRONMENT=dev
INSTANCE_MODE=FULL
APP_NAME=mudrichenkoevgeny-backend-platform-sdk-sample-dev
SERVER_URL="http://localhost:8080"
APP_PORT=8080
ADMIN_APP_PORT=9091
KTOR_SERVER_HOST=0.0.0.0
KTOR_SERVER_PORT=8080
KTOR_MANAGEMENT_PORT=9090
KTOR_SHUTDOWN_GRACE_PERIOD_MS=3000
KTOR_SHUTDOWN_TIMEOUT_MS=10000
LOG_PATH=./logs

# Database
DB_PORT=5432
DB_NAME=mudrichenkoevgeny_backend_platform_sdk_sample_dev_db
DB_URL=jdbc:postgresql://db:5432/mudrichenkoevgeny_backend_platform_sdk_sample_dev_db?currentSchema=public
# DB_URL=jdbc:postgresql://localhost:5432/mudrichenkoevgeny_backend_platform_sdk_sample_dev_db # for local build
DB_WAIT_TIMEOUT=90

# App-specific runtime metadata
AUTH_REALM=mudrichenkoevgeny-backend-platform-sdk-sample-dev-realm
DOMAIN=example.com
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:5173,https://example.com

# Secrets & Encryption files
DB_USER_SECRET_FILE=DB_USER
DB_PASSWORD_SECRET_FILE=DB_PASSWORD
REDIS_URL_SECRET_FILE=REDIS_URL
REDIS_TIMEOUT_SECONDS=5
JWT_SECRET_FILE=JWT_SECRET
TOTP_ENCRYPTION_SECRET_FILE=TOTP_ENCRYPTION_SECRET
ADMIN_ACCOUNTS_JSON_SECRET_FILE=ADMIN_ACCOUNTS_JSON

# Swagger / OpenAPI
SWAGGER_TITLE="Mudrichenko Evgeny Backend Platform SDK Sample API [DEV]"
SWAGGER_DESCRIPTION="Sample backend service. Use this instance for development and testing purposes."
SWAGGER_SERVER_DESCRIPTION="Local Development Server"

# Telemetry & Observability
TELEMETRY_SERVICE_NAME=mudrichenkoevgeny-backend-platform-sdk-sample-dev-otel
TELEMETRY_ENDPOINT=http://otel-collector:4317
METRIC_INTERVAL_SECONDS=10
PROMETHEUS_ENDPOINT=0.0.0.0:9464
TELEMETRY_LOG_LEVEL=debug
OTEL_LOG_LEVEL=debug
JAEGER_ENDPOINT=jaeger:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOKI_SHARED_STORE=filesystem

# External Services (Email clients, Google OAuth, etc.)
GOOGLE_WEB_CLIENT_ID=982478008604-albtrhoegkqkpe2ev7rirg6c8h9hijfl.apps.googleusercontent.com

# UniOne
# UNIONE_API_KEY_FILE=UNIONE_API_KEY
# UNIONE_URL=https://api.unione.io/en/transactional/api/v1/
# UNIONE_FROM_EMAIL=noreply@mudr.life
# UNIONE_FROM_NAME="Mudr Life"
# UNIONE_TRACK_DOMAIN=mail.mudr.life
# UNIONE_API_SEND="email/send.json"

# Resend
RESEND_API_KEY_FILE=RESEND_API_KEY
RESEND_URL=https://api.resend.com
RESEND_FROM_EMAIL=noreply@mudr.life
RESEND_FROM_NAME="Mudr Life"

# Events (Kafka)
EVENTS_TYPE=KAFKA
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=mudrichenkoevgeny-backend-platform-sdk-sample-dev-core-group
KAFKA_CLIENT_ID=main-backend-service

# Storage S3
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET_NAME=uploads
S3_PUBLIC_URL=http://localhost:9000/uploads
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_FILE=S3_ACCESS_KEY
S3_SECRET_KEY_FILE=S3_SECRET_KEY
STORAGE_MAINTENANCE_BATCH_SIZE=100


# =====================================================================
# 2. GLOBAL SETTINGS (ManagementGlobalSettings)
# =====================================================================

PRIVACY_POLICY_URL=https://example.com/privacy-policy
TERMS_OF_SERVICE_URL=https://example.com/terms-of-service
CONTACT_SUPPORT_EMAIL=support@example.com
MIN_SUPPORTED_APP_VERSIONS={}
IS_TRACING_ENABLED=false
IS_METRICS_ENABLED=false
IS_VERBOSE_LOGGING_ENABLED=false


# =====================================================================
# 3. SECURITY SETTINGS (ManagementSecuritySettings)
# =====================================================================

RECENT_AUTHENTICATION_VALIDITY_IN_SECONDS=600
RECENT_AUTHENTICATION_VALIDITY_IN_SECONDS_FOR_MANAGEMENT=1800
MFA_TOKEN_EXPIRATION_SECONDS=300
REFRESH_TOKEN_ROTATION_GRACE_PERIOD_SECONDS=30

PASSWORD_POLICY_MIN_LENGTH=8
PASSWORD_POLICY_REQUIRE_LETTER=true
PASSWORD_POLICY_REQUIRE_UPPER_CASE=false
PASSWORD_POLICY_REQUIRE_LOWER_CASE=false
PASSWORD_POLICY_REQUIRE_DIGIT=false
PASSWORD_POLICY_REQUIRE_SPECIAL_CHAR=false
PASSWORD_POLICY_COMMON_PASSWORDS=password,123456,qwerty,letmein

RATE_LIMIT_MAX_REQUESTS_PER_PERIOD=100
RATE_LIMIT_PERIOD_SECONDS=60

ACCOUNT_LOCKOUT_MAX_FAILED_PASSWORD_ATTEMPTS=5
ACCOUNT_LOCKOUT_MAX_FAILED_OTP_ATTEMPTS=3
ACCOUNT_LOCKOUT_MAX_FAILED_TOTP_ATTEMPTS=3
ACCOUNT_LOCKOUT_WINDOW_SECONDS=600
ACCOUNT_LOCKOUT_DURATION_SECONDS=1800
ACCOUNT_LOCKOUT_INDEFINITE_THRESHOLD=3
IS_SELF_SERVICE_UNLOCK_ENABLED=true

IS_IP_BLACKLIST_ENABLED_OPEN=false
IP_BLACKLIST_OPEN=
IS_IP_WHITELIST_ENABLED_OPEN=false
IP_WHITELIST_OPEN=
IS_IP_BLACKLIST_ENABLED_MANAGEMENT=false
IP_BLACKLIST_MANAGEMENT=
IS_IP_WHITELIST_ENABLED_MANAGEMENT=false
IP_WHITELIST_MANAGEMENT=

# =====================================================================
# 4. STORAGE SETTINGS (ManagementStorageSettings)
# =====================================================================

# Minimum permitted file upload size in bytes (1 Byte)
STORAGE_MIN_UPLOAD_SIZE_BYTES=1

# Maximum permitted single file upload size in bytes (50 MB = 50 * 1024 * 1024 = 52428800 Bytes)
STORAGE_MAX_UPLOAD_SIZE_BYTES=52428800

# Cumulative storage quota in bytes per regular open user (1 GB = 1024 * 1024 * 1024 = 1073741824 Bytes)
STORAGE_TOTAL_QUOTA_OPEN_USER_BYTES=1073741824

# Cumulative storage quota in bytes per management user (empty = unlimited)
STORAGE_TOTAL_QUOTA_MANAGEMENT_USER_BYTES=

# TTL validity duration for presigned upload and download URLs in seconds (15 minutes = 900 seconds)
STORAGE_PRESIGNED_URL_EXPIRATION_SECONDS=900

# Maximum concurrent unfinalized upload sessions for open users
STORAGE_MAX_PENDING_UPLOADS_OPEN_USER=10

# Maximum concurrent unfinalized upload sessions for staff/management users
STORAGE_MAX_PENDING_UPLOADS_MANAGEMENT_USER=100

# Enable Content-Addressable Storage (CAS) file deduplication by SHA-256 hash
STORAGE_IS_DEDUPLICATION_ENABLED=true

# Interval in seconds for physical cleanup of soft-deleted files from S3/storage (24 hours = 86400 seconds)
STORAGE_DELETED_FILES_CLEANUP_INTERVAL_SECONDS=86400

# =====================================================================
# 5. AUTHENTICATION & USER SETTINGS (ManagementAuthSettings)
# =====================================================================

AVAILABLE_AUTH_PROVIDERS_PRIMARY=EMAIL,PHONE
AVAILABLE_AUTH_PROVIDERS_SECONDARY=GOOGLE

MAX_TOTAL_IDENTIFIERS=5
MAX_EMAIL_IDENTIFIERS=2
MAX_PHONE_IDENTIFIERS=2
MAX_IDENTIFIERS_PER_EXTERNAL_PROVIDER=2
MAX_ACTIVE_SESSIONS_FOR_OPEN_USER=5
MAX_ACTIVE_SESSIONS_FOR_MANAGEMENT_USER=3

ACCESS_TOKEN_EXPIRATION_SECONDS=3600
REFRESH_TOKEN_EXPIRATION_SECONDS=2592000
OTP_RETRY_AFTER_SECONDS=60
OTP_NUMBER_OF_SYMBOLS=6
OTP_EXPIRATION_SECONDS=300
ACCOUNT_DELETION_GRACE_PERIOD_SECONDS=2592000
ACCOUNT_DELETION_CHECK_INTERVAL_SECONDS=600
ACCOUNT_LOCKOUT_CHECK_INTERVAL_SECONDS=60

IS_REGISTRATION_ENABLED=true

IS_EMAIL_BLACKLIST_ENABLED_OPEN=false
EMAIL_BLACKLIST_OPEN=@tempmail.com,@disposable.org
IS_EMAIL_WHITELIST_ENABLED_OPEN=false
EMAIL_WHITELIST_OPEN=
IS_EMAIL_BLACKLIST_ENABLED_MANAGEMENT=false
EMAIL_BLACKLIST_MANAGEMENT=@tempmail.com,@disposal.org
IS_EMAIL_WHITELIST_ENABLED_MANAGEMENT=false
EMAIL_WHITELIST_MANAGEMENT=
